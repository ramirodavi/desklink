{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/main.ts", "src/control.ts", "src/keymap.ts", "src/protocol.ts"]
}
