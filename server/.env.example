PORT=3000
# CORS: origem do controlador em produção, ou * em dev
CLIENT_ORIGIN=*

# --- Metered (recomendado): credenciais TURN via API ---
# Domínio do app no painel Metered (ex.: desklink.metered.live, sem https://)
METERED_DOMAIN=desklink.metered.live
# "Show API Key" no painel Metered — não commite este arquivo com a chave real
METERED_API_KEY=

# --- Alternativa: lista ICE estática (se definida, ignora Metered acima) ---
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:...","username":"...","credential":"..."}]
